# PAYSHARK — Environment Configuration
# Add real values in .env.local and Vercel Project Settings. Never commit secrets.

# Neon PostgreSQL (DATABASE_URL preferred; NEON_DATABASE_URL is fallback)
DATABASE_URL=
NEON_DATABASE_URL=

# Groq AI (optional; deterministic fallback is available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PayPal: use sandbox during development and testing
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional bearer key for the agent API example
PAYSHARK_AGENT_KEY=

# Production encryption key: 64 hexadecimal characters (32 random bytes)
ENCRYPTION_KEY=

# Optional HIGH / CRITICAL security alert destination
SECURITY_WEBHOOK_URL=
