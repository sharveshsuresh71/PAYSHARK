# Neon PostgreSQL Database Connection
# Obtain this from your Neon Console (https://console.neon.tech)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=
# NEON_DATABASE_URL= (optional alias)

# Groq LLM API (Server only)
# Used for structured agreement extraction (fallback deterministic parser active if empty)
GROQ_API_KEY=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

GROQ_MODEL=llama-3.3-70b-versatile

# PayPal Sandbox (Server only; do NOT use live credentials in this MVP)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Security (Server only)
# 64 hex chars (32 bytes) for AES-256-GCM; a dev-only derived key is used if unset — set it in production
ENCRYPTION_KEY=
# Optional: receives HIGH / CRITICAL security alerts
SECURITY_WEBHOOK_URL=

# App Settings
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=https://payshark-ktwm-53juwqh6n-shark20.vercel.app/
