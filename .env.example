# ==========================================
# PAYSHARK AI — Environment Configuration
# ==========================================

# Neon PostgreSQL — configure ONE of these (DATABASE_URL is preferred).
# Get the pooled connection string from your Neon project dashboard.
DATABASE_URL=
# Optional alias supported by the code when DATABASE_URL is empty.
NEON_DATABASE_URL=

# Groq AI — optional; deterministic agreement parser is used when unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PayPal Sandbox — keep sandbox for development and testing.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Security — 64 hexadecimal characters (32 random bytes).
# Required for production; development has a fallback key.
ENCRYPTION_KEY=
# Optional HIGH / CRITICAL security alert destination.
SECURITY_WEBHOOK_URL=

# App Settings
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
